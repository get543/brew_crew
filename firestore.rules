rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isBarista() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'barista';
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isBarista());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'customer';
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /menu/{itemId} {
      allow read: if signedIn();
      allow write: if isBarista();
    }

    match /orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isBarista());
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isBarista()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.status in ['pending', 'brewing', 'ready', 'completed'];
      allow delete: if false;
    }
  }
}